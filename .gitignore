# ── 训练产物 ────────────────────────────────────────────────
# runs/ 下的 best.pt 单个 400~470 MB，6 个共约 2.3 GB，
# 远超 GitHub 单文件 100 MB 限制，必须排除。
# 指标结果（metrics.json）也在这里，如需保留请单独拷出来。
runs/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# ── 编辑器 / 系统 ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 模型缓存 ───────────────────────────────────────────────
# HuggingFace 权重会缓存到 ~/.cache/huggingface，正常不会进仓库；
# 这里兜底防止误拷贝进来。
.cache/
hf_cache/

# ── 日志 / 临时文件 ─────────────────────────────────────────
*.log
*.tmp
